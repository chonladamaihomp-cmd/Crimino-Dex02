<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRIMINO-DEX // NOIR BROADSHEET & FORENSIC ARCHIVES</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- High-Fashion Editorial, Korean Neo-Noir Cinema & Vintage Newspaper Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Charmonman:wght@700&family=Cinzel:wght@600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=Noto+Serif+Thai:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Special+Elite&display=swap" rel="stylesheet">
    <!-- Vue 3 Production Build -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        masthead: ['Cinzel', 'Playfair Display', 'Noto Serif Thai', 'serif'],
                        editorial: ['Playfair Display', 'Noto Serif Thai', 'serif'],
                        serifThai: ['Noto Serif Thai', 'Cormorant Garamond', 'serif'],
                        bodyThai: ['IBM Plex Sans Thai', 'Bai Jamjuree', 'sans-serif'],
                        mono: ['Space Mono', 'monospace'],
                        stamp: ['Special Elite', 'Space Mono', 'monospace'],
                        signature: ['Charmonman', 'cursive']
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --bg-paper: #08090b;
            --bg-sheet: #101217;
            --bg-elevated: #161920;
            --bg-inset: #0b0c10;
            --ink-primary: #ece8df;
            --ink-secondary: #c7c1b5;
            --ink-muted: #868075;
            --border-hairline: rgba(236, 232, 223, 0.16);
            --border-strong: rgba(212, 175, 55, 0.55);
            --accent-gold: #d4af37;
            --accent-crimson: #dc2626;
            --accent-uv: #38bdf8;
            --halftone-dot: rgba(236, 232, 223, 0.045);
            --shadow-print: 0 24px 48px -18px rgba(0, 0, 0, 0.85);
        }

        html.theme-light {
            --bg-paper: #f2ede2;
            --bg-sheet: #f8f4eb;
            --bg-elevated: #fffdf9;
            --bg-inset: #e8e1d3;
            --ink-primary: #181715;
            --ink-secondary: #33302b;
            --ink-muted: #635d53;
            --border-hairline: rgba(24, 23, 21, 0.22);
            --border-strong: rgba(153, 27, 27, 0.6);
            --accent-gold: #9a3412;
            --accent-crimson: #991b1b;
            --accent-uv: #0284c7;
            --halftone-dot: rgba(24, 23, 21, 0.04);
            --shadow-print: 0 18px 36px -16px rgba(41, 37, 36, 0.18);
        }

        body {
            background-color: var(--bg-paper);
            color: var(--ink-primary);
            font-family: 'IBM Plex Sans Thai', sans-serif;
            transition: background-color 0.4s ease, color 0.4s ease;
            overflow-x: hidden;
        }

        /* Editorial Broadsheet Surfaces */
        .sheet-surface {
            background-color: var(--bg-sheet);
            border-color: var(--border-hairline);
        }

        .card-editorial {
            background-color: var(--bg-elevated);
            border-color: var(--border-hairline);
            box-shadow: var(--shadow-print);
            transition: border-color 0.25s ease, transform 0.25s ease;
        }

        .card-editorial:hover {
            border-color: var(--border-strong);
        }

        .inset-box {
            background-color: var(--bg-inset);
            border-color: var(--border-hairline);
        }

        .ink-main { color: var(--ink-primary); }
        .ink-sub { color: var(--ink-secondary); }
        .ink-muted { color: var(--ink-muted); }
        .ink-gold { color: var(--accent-gold); }
        .ink-crimson { color: var(--accent-crimson); }
        .ink-uv { color: var(--accent-uv); }
        .border-hair { border-color: var(--border-hairline); }
        .border-accent { border-color: var(--border-strong); }

        /* Vintage Newspaper Halftone & Film Grain Texture */
        .broadsheet-texture {
            background-image: radial-gradient(var(--halftone-dot) 1px, transparent 0);
            background-size: 14px 14px;
        }

        /* Korean Cinema Red Seal Stamp (도장 / ตราประทับสืบสวน) */
        .seal-stamp {
            border: 2px solid var(--accent-crimson);
            color: var(--accent-crimson);
            font-family: 'Special Elite', 'Space Mono', monospace;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            padding: 2px 9px;
            font-size: 0.68rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transform: rotate(-1.5deg);
            box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.25);
        }

        /* Classified CIA/Prosecutor Redacted Black Bar */
        .redacted-bar {
            background-color: #18181b;
            color: transparent;
            padding: 1px 6px;
            border-bottom: 1px dashed var(--accent-crimson);
            cursor: pointer;
            user-select: none;
            transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
        }
        html.theme-light .redacted-bar {
            background-color: #1c1917;
        }
        .redacted-bar:hover,
        .redacted-bar.revealed {
            background-color: rgba(220, 38, 38, 0.14);
            color: var(--ink-primary);
            user-select: text;
        }

        /* UV Blacklight Flashlight Overlay */
        .uv-flashlight-layer {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 45;
            background: radial-gradient(
                circle 210px at var(--mx, 50vw) var(--my, 50vh),
                rgba(56, 189, 248, 0.16) 0%,
                rgba(14, 165, 233, 0.08) 45%,
                rgba(3, 7, 18, 0.86) 85%
            );
            mix-blend-mode: normal;
            transition: opacity 0.3s ease;
        }

        .uv-secret-text {
            opacity: 0.12;
            filter: blur(1.5px);
            transition: all 0.3s ease;
            font-family: 'Space Mono', monospace;
            color: var(--accent-uv);
        }
        .uv-active .uv-secret-text {
            opacity: 1;
            filter: blur(0);
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.75);
        }

        /* Filmstrip Perforations */
        .filmstrip-bar {
            background-image: repeating-linear-gradient(
                90deg,
                transparent 0px,
                transparent 10px,
                var(--border-hairline) 10px,
                var(--border-hairline) 16px
            );
        }

        /* 3D Flashcard Flip */
        .perspective-1200 { perspective: 1200px; }
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 { transform: rotateY(180deg); }

        /* Drop Cap for Newspaper Articles */
        .editorial-dropcap::first-letter {
            float: left;
            font-family: 'Playfair Display', 'Noto Serif Thai', serif;
            font-size: 3.1rem;
            line-height: 0.85;
            padding-right: 0.65rem;
            padding-top: 0.2rem;
            color: var(--accent-gold);
            font-weight: 700;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 7px; height: 7px; }
        ::-webkit-scrollbar-track { background: var(--bg-paper); }
        ::-webkit-scrollbar-thumb { background: var(--border-hairline); }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent-gold); }
    </style>
</head>
<body :class="{ 'uv-active': uvMode }" class="min-h-screen relative broadsheet-texture selection:bg-red-700 selection:text-white">

    <!-- Ambient Abstract Noir Smoke & Rain Particle Canvas -->
    <canvas id="noirAtmosphereCanvas" class="fixed inset-0 pointer-events-none z-0 opacity-65"></canvas>

    <!-- UV Blacklight Cursor Flashlight Layer -->
    <div v-if="uvMode" class="uv-flashlight-layer" :style="{ '--mx': mouseX + 'px', '--my': mouseY + 'px' }"></div>

    <div id="app" class="min-h-screen flex flex-col relative z-10">

        <!-- Archival Toast Notification -->
        <div v-if="toastMessage"
             class="fixed bottom-6 right-6 z-50 px-5 py-3.5 border border-accent card-editorial shadow-2xl flex items-center space-x-3 max-w-sm">
            <span class="w-2 h-2 bg-red-600 inline-block animate-ping"></span>
            <p class="text-xs font-mono ink-main tracking-wide">{{ toastMessage }}</p>
        </div>

        <!-- =====================================================================
             VINTAGE BROADSHEET NEWSPAPER MASTHEAD HEADER
             ===================================================================== -->
        <header class="border-b-2 border-hair sheet-surface/95 backdrop-blur-md sticky top-0 z-30">
            <!-- Top Filmstrip Perforation Strip -->
            <div class="h-2 w-full filmstrip-bar border-b border-hair opacity-70"></div>

            <!-- Broadsheet Metadata Ticker -->
            <div class="border-b border-hair px-4 sm:px-8 py-1.5 text-[11px] font-mono ink-muted flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center space-x-3">
                    <span class="ink-crimson font-bold">● SPECIAL INVESTIGATIVE EDITION</span>
                    <span class="hidden sm:inline">|</span>
                    <span class="hidden sm:inline">VOL. XCIV • NO. 402</span>
                    <span>|</span>
                    <span>SEOUL — BANGKOK ARCHIVE</span>
                </div>
                <div class="flex items-center space-x-3">
                    <span>WEATHER: MIDNIGHT RAIN 14°C</span>
                    <span>|</span>
                    <span class="ink-gold font-bold">CURATED FOR PRAE (แพร)</span>
                </div>
            </div>

            <!-- Main Masthead & Controls -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <!-- Editorial Masthead Title -->
                    <div class="flex items-start sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-baseline space-x-3">
                                <h1 class="font-masthead text-2xl sm:text-4xl font-extrabold tracking-widest ink-main uppercase">
                                    THE CRIMINO-DEX
                                </h1>
                                <span class="font-editorial italic text-sm sm:text-base ink-gold hidden sm:inline">
                                    Noir &amp; Forensic Gazette
                                </span>
                            </div>
                            <p class="font-serifThai text-xs sm:text-sm ink-sub mt-0.5">
                                {{ lang === 'th'
                                    ? 'หนังสือพิมพ์และคลังแฟ้มคดีสืบสวนเชิงลึก • ทฤษฎีอาชญาวิทยา นิติวิทยาศาสตร์ และบรรณานุกรมงานวิจัยระดับอาจารย์'
                                    : 'Editorial Archives of Criminology, Forensic Reconstruction & Seminal Academic Literature' }}
                            </p>
                        </div>

                        <!-- Mobile Quick Toggles -->
                        <div class="flex lg:hidden items-center gap-1.5">
                            <button @click="toggleUvMode"
                                    :class="uvMode ? 'border-sky-400 text-sky-400 bg-sky-950/50' : 'border-hair ink-sub'"
                                    class="px-2.5 py-1.5 border text-[11px] font-mono font-bold" title="UV Blacklight">
                                UV
                            </button>
                            <button @click="toggleLang" class="px-2.5 py-1.5 border border-hair text-[11px] font-mono font-bold ink-gold">
                                {{ lang === 'th' ? 'TH/EN' : 'EN/TH' }}
                            </button>
                            <button @click="toggleTheme" class="px-2.5 py-1.5 border border-hair text-xs ink-main">
                                {{ isDark ? '☀' : '☾' }}
                            </button>
                        </div>
                    </div>

                    <!-- Interactive Gimmick Toolbar (UV Light, Ambient Audio, Theme, Bilingual) -->
                    <div class="hidden lg:flex items-center space-x-2">
                        <!-- Forensic UV Flashlight Gimmick -->
                        <button @click="toggleUvMode"
                                :class="uvMode ? 'border-sky-400 bg-sky-500/15 text-sky-300 shadow-[0_0_15px_rgba(56,189,248,0.3)]' : 'border-hair card-editorial ink-sub hover:ink-main'"
                                class="px-3 py-1.5 border text-xs font-mono transition flex items-center space-x-1.5">
                            <span>🔦</span>
                            <span>{{ uvMode ? (lang === 'th' ? 'ปิดไฟฉาย UV' : 'UV LAMP: ON') : (lang === 'th' ? 'ไฟฉายตรวจคราบ UV' : 'UV BLACKLIGHT') }}</span>
                        </button>

                        <!-- Soundscape Selector -->
                        <button @click="cycleAudioMode"
                                :class="audioMode !== 'off' ? 'border-accent ink-gold bg-amber-500/10' : 'border-hair card-editorial ink-sub'"
                                class="px-3 py-1.5 border text-xs font-mono transition flex items-center space-x-1.5">
                            <span>{{ audioMode === 'off' ? '🔇' : (audioMode === 'rain' ? '🌧️' : '⌨️') }}</span>
                            <span>
                                {{ audioMode === 'off'
                                    ? (lang === 'th' ? 'เสียงบรรยากาศ' : 'AMBIENCE')
                                    : (audioMode === 'rain'
                                        ? (lang === 'th' ? 'ฝนตกโซล' : 'SEOUL RAIN')
                                        : (lang === 'th' ? 'พิมพ์ดีด & เทป' : 'TYPEWRITER')) }}
                            </span>
                        </button>

                        <!-- Bilingual Switch -->
                        <button @click="toggleLang"
                                class="px-3 py-1.5 border border-hair card-editorial text-xs font-mono font-bold ink-gold hover:border-accent transition">
                            {{ lang === 'th' ? '🌐 ไทย | EN' : '🌐 EN | ไทย' }}
                        </button>

                        <!-- Theme Switch -->
                        <button @click="toggleTheme"
                                class="px-3 py-1.5 border border-hair card-editorial text-xs font-mono ink-main hover:border-accent transition">
                            {{ isDark ? (lang === 'th' ? '☀ ฉบับกระดาษ' : '☀ BROADSHEET') : (lang === 'th' ? '☾ ฉบับนัวร์' : '☾ NOIR INK') }}
                        </button>
                    </div>
                </div>

                <!-- Broadsheet Section Navigation Bar -->
                <nav class="mt-4 pt-3 border-t border-hair flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                        <button v-for="(tab, idx) in navTabs" :key="tab.id"
                                @click="switchTab(tab.id)"
                                :class="activeTab === tab.id
                                    ? 'bg-red-800 text-amber-50 border-red-700 font-bold'
                                    : 'inset-box ink-sub border-hair hover:ink-main hover:border-accent'"
                                class="px-3.5 py-1.5 border text-xs sm:text-sm font-serifThai transition flex items-center space-x-2">
                            <span class="font-mono text-[10px] opacity-75">0{{ idx + 1 }}.</span>
                            <span>{{ lang === 'th' ? tab.labelTh : tab.labelEn }}</span>
                        </button>
                    </div>

                    <!-- Interactive Redacted Hint -->
                    <div class="text-[11px] font-mono ink-muted hidden xl:flex items-center space-x-2">
                        <span>TIP:</span>
                        <span>{{ lang === 'th' ? 'คลิกแถบดำเพื่อเปิดความลับ หรือเปิดไฟฉาย UV ส่องหาเบาะแสซ่อน' : 'Click black censor bars to declassify, or toggle UV lamp for hidden traces' }}</span>
                    </div>
                </nav>
            </div>
        </header>

        <!-- =====================================================================
             MAIN EDITORIAL CONTENT STAGE
             ===================================================================== -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

            <!-- =================================================================
                 SECTION 01: NOIR BROADSHEET CASE FILES (เรื่องเล่าสืบสวน & ถอดรหัส)
                 ================================================================= -->
            <section v-if="activeTab === 'cases'" class="space-y-8">
                <!-- Broadsheet Lead Headline Banner -->
                <div class="card-editorial border-2 border-hair p-6 sm:p-8 relative">
                    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-hair pb-6">
                        <div class="space-y-2 max-w-3xl">
                            <div class="flex items-center flex-wrap gap-3">
                                <span class="seal-stamp">ARCHIVAL DOSSIER // เอกสารลับเฉพาะ</span>
                                <span class="font-mono text-xs ink-gold">SCENE 0{{ selectedCaseIndex + 1 }} OF 0{{ casesData.length }}</span>
                            </div>
                            <h2 class="font-serifThai text-2xl sm:text-4xl font-bold ink-main leading-tight">
                                {{ lang === 'th' ? 'แฟ้มคดีสืบสวนเชิงวรรณกรรม & การถอดรหัสทางอาชญาวิทยา' : 'Cinematic Noir Case Chronicles & Theoretical Decoding' }}
                            </h2>
                            <p class="font-bodyThai text-sm sm:text-base ink-sub leading-relaxed">
                                {{ lang === 'th'
                                    ? 'อ่านเรื่องสั้นสืบสวนที่จำลองจากทฤษฎีอาชญาวิทยาและหลักนิติวิทยาศาสตร์จริง ลองกดเปิดแถบข้อมูลลับที่ถูกขีดฆ่า (Redacted) หรือเปิดไฟฉาย UV ส่องหาข้อความที่ซ่อนอยู่บนหน้ากระดาษก่อนวินิจฉัยคดีค่ะ'
                                    : 'Immerse yourself in Korean-noir inspired investigative narratives. Click black redacted bars to declassify statements or sweep the UV Blacklight across the dossier to uncover latent forensic clues.' }}
                            </p>
                        </div>

                        <!-- Case Selection Index Tabs -->
                        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 shrink-0">
                            <button v-for="(c, idx) in casesData" :key="c.id"
                                    @click="selectCase(idx)"
                                    :class="selectedCaseIndex === idx
                                        ? 'border-accent ink-gold inset-box font-bold'
                                        : 'border-hair ink-muted hover:ink-main'"
                                    class="px-3.5 py-2 border text-left font-mono text-xs transition">
                                <div class="text-[10px] opacity-75">REEL #0{{ idx + 1 }}</div>
                                <div class="font-serifThai text-xs sm:text-sm truncate max-w-[150px]">
                                    {{ lang === 'th' ? c.shortTitleTh : c.shortTitleEn }}
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Hidden UV Forensic Watermark inside Banner -->
                    <div class="pt-3 flex items-center justify-between text-xs">
                        <span class="font-mono ink-muted">
                            {{ lang === 'th' ? 'สถานะแฟ้ม: เปิดให้ตรวจสอบโดยนักสืบแพร' : 'FILE STATUS: CLEARED FOR DETECTIVE PRAE' }}
                        </span>
                        <span class="uv-secret-text text-[11px]">
                            [UV TRACE DETECTED: {{ currentCase.uvSecretCode }}]
                        </span>
                    </div>
                </div>

                <!-- Two-Column Broadsheet Layout -->
                <div v-if="currentCase" class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                    <!-- LEFT 7 COLUMNS: ABSTRACT GENERATIVE NOIR ARTWORK + MULTI-ACT NARRATIVE -->
                    <div class="lg:col-span-7 space-y-6">
                        <article class="card-editorial border border-hair overflow-hidden">
                            <!-- Abstract Neo-Noir Cinema Generative SVG Plate -->
                            <div class="relative h-64 sm:h-72 bg-[#07080a] border-b border-hair overflow-hidden">
                                <!-- Case 1 Abstract Art: Rain at Yeouido Pier (Concentric Ripples, Prism Beam & Silhouette) -->
                                <svg v-if="currentCase.id === 'case-yeouido'" class="w-full h-full" viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice">
                                    <defs>
                                        <linearGradient id="noirGrad1" x1="0" y1="0" x2="1" y2="1">
                                            <stop offset="0%" stop-color="#060709"/>
                                            <stop offset="55%" stop-color="#131722"/>
                                            <stop offset="100%" stop-color="#2a0a0d"/>
                                        </linearGradient>
                                        <radialGradient id="crimsonMoon" cx="72%" cy="32%" r="35%">
                                            <stop offset="0%" stop-color="#dc2626" stop-opacity="0.75"/>
                                            <stop offset="60%" stop-color="#991b1b" stop-opacity="0.2"/>
                                            <stop offset="100%" stop-color="#000" stop-opacity="0"/>
                                        </radialGradient>
                                    </defs>
                                    <rect width="800" height="320" fill="url(#noirGrad1)"/>
                                    <circle cx="576" cy="102" r="130" fill="url(#crimsonMoon)"/>
                                    <circle cx="576" cy="102" r="34" fill="#dc2626" fill-opacity="0.85"/>
                                    <!-- Abstract Brutalist Bridge & Rain Geometry -->
                                    <line x1="0" y1="215" x2="800" y2="185" stroke="#d4af37" stroke-width="1.2" stroke-opacity="0.6"/>
                                    <polygon points="110,320 260,80 390,320" fill="#ece8df" fill-opacity="0.04" stroke="#ece8df" stroke-opacity="0.15"/>
                                    <!-- Abstract Trenchcoat Figure Silhouette -->
                                    <path d="M245 320 L256 178 C256 165 274 165 274 178 L288 320 Z" fill="#050608"/>
                                    <circle cx="265" cy="154" r="11" fill="#050608"/>
                                    <!-- Concentric Water Ripples -->
                                    <ellipse cx="520" cy="265" rx="140" ry="18" fill="none" stroke="#38bdf8" stroke-opacity="0.35" stroke-width="1"/>
                                    <ellipse cx="520" cy="265" rx="85" ry="10" fill="none" stroke="#d4af37" stroke-opacity="0.5" stroke-width="1"/>
                                    <!-- Diagonal Rain Lines -->
                                    <g stroke="#ece8df" stroke-opacity="0.22" stroke-width="0.9">
                                        <line x1="90" y1="10" x2="60" y2="120"/><line x1="190" y1="30" x2="160" y2="140"/>
                                        <line x1="340" y1="0" x2="310" y2="110"/><line x1="470" y1="45" x2="440" y2="155"/>
                                        <line x1="690" y1="20" x2="660" y2="130"/><line x1="750" y1="60" x2="720" y2="170"/>
                                    </g>
                                    <text x="28" y="296" fill="#d4af37" font-family="Space Mono, monospace" font-size="11" letter-spacing="3">FIG. 01 // YEOUIDO ESTUARY — 01:42 AM</text>
                                </svg>

                                <!-- Case 2 Abstract Art: Samcheong-dong Glass Alibi (Cubist Glass Shards & Golden Ratio Spiral) -->
                                <svg v-else-if="currentCase.id === 'case-samcheong'" class="w-full h-full" viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice">
                                    <rect width="800" height="320" fill="#090b0f"/>
                                    <!-- Abstract Fractured Glass Polygons -->
