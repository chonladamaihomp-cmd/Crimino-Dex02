                const boardSvg = ref(null);

                const getNode = (id) => networkNodes.value.find((n) => n.id === id) || networkNodes.value[0];
                const activeNetworkNode = computed(() => getNode(selectedNodeId.value));

                const isNodeConnected = (id) => {
                    if (id === selectedNodeId.value) return true;
                    return networkEdges.some(
                        (e) => (e.from === selectedNodeId.value && e.to === id) || (e.to === selectedNodeId.value && e.from === id)
                    );
                };

                const isEdgeHighlighted = (edge) => edge.from === selectedNodeId.value || edge.to === selectedNodeId.value;

                const activeNodeConnections = computed(() => {
                    const ids = new Set();
                    networkEdges.forEach((e) => {
                        if (e.from === selectedNodeId.value) ids.add(e.to);
                        if (e.to === selectedNodeId.value) ids.add(e.from);
                    });
                    return Array.from(ids).map((id) => getNode(id));
                });

                const getSvgCoords = (clientX, clientY) => {
                    if (!boardSvg.value) return { x: 0, y: 0 };
                    const rect = boardSvg.value.getBoundingClientRect();
                    const scaleX = 780 / rect.width;
                    const scaleY = 480 / rect.height;
                    return {
                        x: Math.max(76, Math.min(704, (clientX - rect.left) * scaleX)),
                        y: Math.max(36, Math.min(444, (clientY - rect.top) * scaleY))
                    };
                };

                const startBoardDrag = (id) => {
                    selectedNodeId.value = id;
                    draggingNodeId.value = id;
                    playFoleyClick(540);
                };

                const onBoardDrag = (e) => {
                    if (!draggingNodeId.value) return;
                    const pos = getSvgCoords(e.clientX, e.clientY);
                    const node = getNode(draggingNodeId.value);
                    node.x = pos.x;
                    node.y = pos.y;
                };

                const startBoardTouchDrag = (id) => {
                    selectedNodeId.value = id;
                    draggingNodeId.value = id;
                };

                const onBoardTouchDrag = (e) => {
                    if (!draggingNodeId.value || !e.touches[0]) return;
                    const pos = getSvgCoords(e.touches[0].clientX, e.touches[0].clientY);
                    const node = getNode(draggingNodeId.value);
                    node.x = pos.x;
                    node.y = pos.y;
                };

                const endBoardDrag = () => {
                    draggingNodeId.value = null;
                };

                const resetBoardPositions = () => {
                    networkNodes.value = initialNodes();
                    playFoleyClick(440);
                };

                // =====================================================================
                // DATA 5: 3D ARCHIVAL INDEX FLASHCARDS
                // =====================================================================
                const flashcardsData = [
                    {
                        id: 'fc1',
                        categoryTh: 'อาชญาวิทยา // โครงสร้าง',
                        categoryEn: 'CRIMINOLOGY // STRUCTURAL',
                        theorist: 'Robert K. Merton (1938)',
                        frontTh: 'การปรับตัวแบบ "Innovation" ในทฤษฎี Strain Theory ของ Merton หมายถึงอะไร?',
                        frontEn: 'What does "Innovation" signify in Merton’s Strain Theory?',
                        backTh: 'การที่บุคคลยอมรับเป้าหมายความสำเร็จทางวัฒนธรรม (ความมั่งคั่ง) แต่ขาดหรือปฏิเสธช่องทางที่ถูกกฎหมาย จึงหันไปใช้วิธีการที่ผิดกฎหมาย (เช่น ลักทรัพย์ ฉ้อโกง) เพื่อบรรลุเป้าหมายนั้น',
                        backEn: 'Accepting culturally prescribed wealth goals while lacking or rejecting legitimate institutional means, turning to illicit methods.',
                        tipTh: 'จำสูตรย่อ: เป้าหมาย (+) แต่วิธีการถูกกฎหมาย (-) = Innovation',
                        tipEn: 'Formula: Cultural Goals (+) / Institutional Means (-) = Innovation.'
                    },
                    {
                        id: 'fc2',
                        categoryTh: 'อาชญาวิทยา // สถานการณ์',
                        categoryEn: 'CRIMINOLOGY // SITUATIONAL',
                        theorist: 'Cohen & Felson (1979)',
                        frontTh: 'องค์ประกอบ 3 ประการ (Crime Triangle) ในทฤษฎี Routine Activity Theory คืออะไรบ้าง?',
                        frontEn: 'Name the 3 converging elements in Routine Activity Theory.',
                        backTh: '1. ผู้กระทำผิดที่มีแรงจูงใจ (Motivated Offender) 2. เป้าหมายที่เหมาะสม (Suitable Target - VIVA) และ 3. การขาดผู้พิทักษ์ที่สามารถยับยั้งได้ (Absence of a Capable Guardian)',
                        backEn: '1. Motivated offender, 2. Suitable target (VIVA), and 3. Absence of a capable guardian.',
                        tipTh: 'หากตัดขาใดขาหนึ่งของสามเหลี่ยมนี้ได้ อาชญากรรมจะไม่เกิดขึ้น',
                        tipEn: 'Remove any single leg of the triangle and the offense is prevented.'
                    },
                    {
                        id: 'fc3',
                        categoryTh: 'นิติวิทยาศาสตร์ // รากฐาน',
                        categoryEn: 'FORENSIC // FOUNDATIONS',
                        theorist: 'Dr. Edmond Locard (1910)',
                        frontTh: 'หัวใจสำคัญของ Locard’s Exchange Principle คืออะไร และนำไปสู่การตรวจหลักฐานประเภทใด?',
                        frontEn: 'What is the core tenet of Locard’s Exchange Principle?',
                        backTh: '"Every contact leaves a trace" (ทุกการสัมผัสย่อมทิ้งร่องรอย) เมื่อวัตถุสองสิ่งสัมผัสกันย่อมเกิดการถ่ายโอนพยานหลักฐานขนาดเล็ก (Trace Evidence) เช่น เส้นผม เส้นใยผ้า เศษกระจก และดิน',
                        backEn: '"Every contact leaves a trace." Physical contact between two surfaces produces a cross-transfer of microscopic trace evidence.',
                        tipTh: 'เป็นเหตุผลที่ต้องสวม PPE และเปลี่ยนถุงมือทุกครั้งที่เก็บวัตถุพยานแต่ละชิ้น',
                        tipEn: 'Why investigators wear PPE and change gloves between each item.'
                    },
                    {
                        id: 'fc4',
                        categoryTh: 'อาชญาวิทยา // การควบคุม',
                        categoryEn: 'CRIMINOLOGY // CONTROL',
                        theorist: 'Travis Hirschi (1969)',
                        frontTh: 'พันธะทางสังคม 4 ประการ (4 Social Bonds) ของ Hirschi ประกอบด้วยอะไรบ้าง?',
                        frontEn: 'List the four elements of Hirschi’s Social Bond Theory.',
                        backTh: '1. Attachment (ความผูกพันทางใจ) 2. Commitment (ความมุ่งมั่นลงทุนกับอนาคต) 3. Involvement (การร่วมกิจกรรมสร้างสรรค์) 4. Belief (ความศรัทธาในกฎหมาย)',
                        backEn: '1. Attachment, 2. Commitment, 3. Involvement, and 4. Belief.',
                        tipTh: 'ท่องย่อว่า A - C - I - B (Attachment, Commitment, Involvement, Belief)',
                        tipEn: 'Acronym: A - C - I - B.'
                    },
                    {
                        id: 'fc5',
                        categoryTh: 'อาชญาวิทยา // วิพากษ์',
                        categoryEn: 'CRIMINOLOGY // CRITICAL',
                        theorist: 'Edwin Lemert & Howard Becker',
                        frontTh: 'ความแตกต่างระหว่าง Primary Deviance และ Secondary Deviance ในทฤษฎีการตีตราคืออะไร?',
                        frontEn: 'Differentiate Primary Deviance from Secondary Deviance.',
                        backTh: 'Primary Deviance คือการทำผิดครั้งแรกที่ยังไม่กระทบอัตลักษณ์ ส่วน Secondary Deviance คือการกระทำผิดซ้ำหลังถูกสังคมตีตรา (Stigma) จนยอมรับอัตลักษณ์อาชญากรเป็นตัวตนหลัก (Master Status)',
                        backEn: 'Primary deviance is initial norm-breaking; Secondary deviance is continued offending after societal labeling creates a stigmatized Master Status.',
                        tipTh: 'Primary = ทำผิดก่อนถูกตีตรา | Secondary = ทำผิดซ้ำเพราะป้ายตรา',
                        tipEn: 'Primary = pre-label act | Secondary = post-label identity.'
                    },
                    {
                        id: 'fc6',
                        categoryTh: 'นิติวิทยาศาสตร์ // กฎหมายพยาน',
                        categoryEn: 'FORENSIC // EVIDENTIARY LAW',
                        theorist: 'U.S. Supreme Court (1993)',
                        frontTh: 'มาตรฐาน Daubert Standard กำหนดเกณฑ์ตรวจสอบพยานผู้เชี่ยวชาญไว้กี่ประการ และใครทำหน้าที่เป็น Gatekeeper?',
                        frontEn: 'How many prongs define the Daubert Standard, and who acts as Gatekeeper?',
                        backTh: 'ผู้พิพากษา (Trial Judge) ทำหน้าที่เป็น Gatekeeper ตรวจสอบ 5 เกณฑ์: ทดสอบซ้ำได้ (Testability), ผ่าน Peer-Review, มีอัตราคลาดเคลื่อนชัดเจน (Known Error Rate), มีมาตรฐานควบคุม และเป็นที่ยอมรับในวงการ',
                        backEn: 'The Trial Judge acts as Gatekeeper across 5 prongs: testability, peer review, known error rates, operational standards, and general acceptance.',
                        tipTh: 'คำสำคัญออกสอบบ่อย: Judicial Gatekeeper + Known Error Rate',
                        tipEn: 'Key terms: Judicial Gatekeeper + Known Error Rate.'
                    }
                ];

                const currentCardIndex = ref(0);
                const isCardFlipped = ref(false);
                const masteredCards = ref([]);

                const currentFlashcard = computed(() => flashcardsData[currentCardIndex.value]);

                const nextCard = () => {
                    isCardFlipped.value = false;
                    currentCardIndex.value = (currentCardIndex.value + 1) % flashcardsData.length;
                    playFoleyClick(500);
                };

                const prevCard = () => {
                    isCardFlipped.value = false;
                    currentCardIndex.value = (currentCardIndex.value - 1 + flashcardsData.length) % flashcardsData.length;
                    playFoleyClick(460);
                };

                const toggleMastered = (id) => {
                    const idx = masteredCards.value.indexOf(id);
                    if (idx === -1) {
                        masteredCards.value.push(id);
                        playFoleyClick(760);
                        showToast(lang.value === 'th' ? 'บันทึกบัตรนี้เข้าคลังจำแม่นแล้วค่ะ ★' : 'Indexed as Mastered ★');
                    } else {
                        masteredCards.value.splice(idx, 1);
                    }
                };

                const resetFlashcards = () => {
                    masteredCards.value = [];
                    currentCardIndex.value = 0;
                    isCardFlipped.value = false;
                };

                // =====================================================================
                // AMBIENT ABSTRACT NOIR SMOKE & RAIN PARTICLE ENGINE + UV CURSOR TRACKER
                // =====================================================================
                let animFrameId = null;

                const handleMouseMove = (e) => {
                    mouseX.value = e.clientX;
                    mouseY.value = e.clientY;
                };

                onMounted(() => {
                    window.addEventListener('mousemove', handleMouseMove);

                    const canvas = document.getElementById('noirAtmosphereCanvas');
                    if (canvas) {
                        const ctx = canvas.getContext('2d');
                        const resize = () => {
                            canvas.width = window.innerWidth;
                            canvas.height = window.innerHeight;
                        };
                        resize();
                        window.addEventListener('resize', resize);

                        const motes = Array.from({ length: 42 }, () => ({
                            x: Math.random() * canvas.width,
                            y: Math.random() * canvas.height,
                            r: 0.8 + Math.random() * 2.2,
                            vx: -0.15 + Math.random() * 0.3,
                            vy: -0.25 - Math.random() * 0.35,
                            alpha: 0.12 + Math.random() * 0.3
                        }));

                        const renderAtmosphere = () => {
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                            motes.forEach((m) => {
                                m.x += m.vx;
                                m.y += m.vy;
                                if (m.y < -10) {
                                    m.y = canvas.height + 10;
                                    m.x = Math.random() * canvas.width;
                                }
                                if (m.x < -10) m.x = canvas.width + 10;
                                if (m.x > canvas.width + 10) m.x = -10;

                                ctx.beginPath();
                                ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
                                ctx.fillStyle = isDark.value
                                    ? `rgba(212, 175, 55, ${m.alpha})`
                                    : `rgba(153, 27, 27, ${m.alpha * 0.65})`;
                                ctx.fill();
                            });
                            animFrameId = requestAnimationFrame(renderAtmosphere);
                        };
                        renderAtmosphere();
                    }
                });

                onUnmounted(() => {
                    window.removeEventListener('mousemove', handleMouseMove);
                    stopAudioEngine();
                    if (animFrameId) cancelAnimationFrame(animFrameId);
                });

                return {
                    lang,
                    isDark,
                    activeTab,
                    navTabs,
                    toastMessage,
                    uvMode,
                    mouseX,
                    mouseY,
                    revealedSecrets,
                    audioMode,
                    switchTab,
                    toggleLang,
                    toggleTheme,
                    toggleUvMode,
                    toggleRedacted,
                    cycleAudioMode,
                    buildScholarUrl,
                    buildSemanticScholarUrl,
                    buildYoutubeUrl,
                    copyCitation,
                    // Tab 1
                    casesData,
                    selectedCaseIndex,
                    selectedOption,
                    revealCaseBreakdown,
                    currentCase,
                    selectCase,
                    answerCaseQuestion,
                    // Tab 2
                    searchQuery,
                    selectedCategory,
                    theoryCategories,
                    theoriesData,
                    filteredTheories,
                    // Tab 3
                    analyzerForm,
                    analyzerPresets,
                    applyAnalyzerPreset,
                    synthesizedResult,
                    copyAnalyzerReport,
                    // Tab 4
                    boardSvg,
                    networkNodes,
                    networkEdges,
                    selectedNodeId,
                    getNode,
                    activeNetworkNode,
                    isNodeConnected,
                    isEdgeHighlighted,
                    activeNodeConnections,
                    startBoardDrag,
                    onBoardDrag,
                    startBoardTouchDrag,
                    onBoardTouchDrag,
                    endBoardDrag,
                    resetBoardPositions,
                    // Tab 5
                    flashcardsData,
                    currentCardIndex,
                    isCardFlipped,
                    masteredCards,
                    currentFlashcard,
                    nextCard,
                    prevCard,
                    toggleMastered,
                    resetFlashcards
                };
            }
        }).mount('#app');
    </script>
